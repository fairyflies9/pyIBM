% Taylor-Green vortex on the doubly periodic unit box, mac back end
% u = -cos(2 pi x) sin(2 pi y) exp(-8 pi^2 nu t), v = sin(2 pi x) cos(2 pi y) exp(-8 pi^2 nu t)
% fluid only; the initial field is the initial_velocity hook in hooks.py
% generated by generate.py, do not edit by hand

Fluid_Parameters {
    rho = 1.0
    mu = 0.01
}

Temporal_Information {
    Tfinal = 0.5
    dt = 0.002
}

Grid_Parameters {
    Nx = 64
    Ny = 64
    Lx = 1.0
    Ly = 1.0
}

Solver {
    backend = "mac"
    time_scheme = "midpoint"
    coupling = "delta"
    kernel = "peskin4"
    remove_mean_force = false
    blob = "gaussian4"
    blob_delta = 3.0
    patch = 0
    blob_interpolation = "streamfunction"
    advection = "central"
    viscous = "implicit"
    mac_projection = "nonincremental"
}

Boundary_Conditions {
    left = "periodic"
    right = "periodic"
    bottom = "periodic"
    top = "periodic"
}

Lag_Structure_Info {
    gravity_x = 0.0
    gravity_y = 0.0
}

Output_Info {
    print_dump = 25
    save_vtk = true
    save_history = true
    plot = false
    output_dir = "viz/mac"
}

Hooks {
    file = "hooks.py"
}
